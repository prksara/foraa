# ==========================================
# BACKEND ENVIRONMENT VARIABLES
# ==========================================
FORRAA_ENV=development

# The SQLAlchemy connection string for asyncpg to your Supabase Postgres database.
# Make sure to use the postgresql+asyncpg:// driver instead of just postgresql://
# E.g., postgresql+asyncpg://postgres.[your-project-id]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Your Groq or OpenAI configuration for the AI models
MODEL_PROVIDER=groq
MODEL_NAME=qwen/qwen3.6-27b
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=
HF_TOKEN=

# Supabase Auth configuration for the backend JWT verification
SUPABASE_URL=
SUPABASE_JWT_SECRET=sb_secret_3nrkuhMF8fE2qb1U11QJoA_e_SO6F0G

# ==========================================
# FRONTEND ENVIRONMENT VARIABLES
# ==========================================
# Make sure to create a frontend/web/.env file and place these there as well
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=